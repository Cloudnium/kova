NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
# Solo servidor (crear/editar usuarios). NUNCA con prefijo NEXT_PUBLIC
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
# Opcional: activa preguntas libres en el Asistente
# ANTHROPIC_API_KEY=
# Notificaciones push (genera el par con: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tucorreo@ejemplo.com
# SEO / dominio público (sin barra final)
NEXT_PUBLIC_SITE_URL=https://licoreriakova.com
# Verificación Google Search Console (meta tag HTML)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ===== Culqi (pago en línea: Tarjeta, Yape, PagoEfectivo) =====
# CulqiPanel > Desarrollo > API Keys. Empieza con las llaves de INTEGRACIÓN (pk_test_… / sk_test_…) y al final cambia a las de PRODUCCIÓN (pk_live_… / sk_live_…).
NEXT_PUBLIC_CULQI_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxx
CULQI_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
# Clave que tú inventas (larga y aleatoria); va al final de la URL del webhook: /api/culqi/webhook?k=ESTA_CLAVE
CULQI_WEBHOOK_SECRET=
# Opcional: horas de vigencia del código PagoEfectivo (1 a 168, por defecto 24)
# CULQI_ORDER_EXPIRY_HOURS=24
# Opcional: 1 = usa la ventana flotante de Culqi en vez del formulario incrustado
# NEXT_PUBLIC_CULQI_MODAL=0
